{
  "name": "visualcorrection",
  "version": "1.0.0",
  "description": "System Display Service",
  "author": "System Admin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "signal": "node signaling-server.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.system.service",
    "productName": "System Service",
    "files": [
      "main.js",
      "preload.js",
      "broadcaster.html",
      "viewer.html",
      "signaling-server.js",
      "package.json",
      "icon.png",
      ".env"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^26.0.12"
  }
}
